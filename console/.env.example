# Platform Console (5177) — mesmo projeto Supabase que o app SaaS (5176) e o server (3001).

VITE_CONSOLE_SUPABASE_URL=https://SEU_REF.supabase.co

# Uma chave pública completa — prefira anon JWT (eyJ…) para login local:
VITE_CONSOLE_SUPABASE_ANON_KEY=
# Alternativa publishable (sb_publishable_…); se der "Failed to fetch", use anon JWT acima.
# VITE_CONSOLE_SUPABASE_PUBLISHABLE_KEY=

# Admin API — obrigatório para login (GET /internal/platform/console-profile) e provisionamento.
# Chave interna compartilhada com server/.env → PLATFORM_API_KEY
VITE_PLATFORM_API_KEY=

# Base da API (opcional em dev: o Vite faz proxy de /internal/platform → 3001)
# VITE_PLATFORM_API_BASE_URL=http://127.0.0.1:3001
