# Supabase exclusivo da Platform Console (projeto separado do app principal).
# Copie este arquivo para `.env` e preencha com Settings → API do MESMO projeto.
# Não use placeholders tipo eyJ... ou ... no fim — a chave inteira vem do dashboard.

VITE_CONSOLE_SUPABASE_URL=https://SEU_REF.supabase.co

# Defina UMA das duas (anon JWT eyJ… longo OU publishable sb_publishable_… completa):
VITE_CONSOLE_SUPABASE_ANON_KEY=
# VITE_CONSOLE_SUPABASE_PUBLISHABLE_KEY=
