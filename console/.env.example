# Supabase da Platform Console.
# Em dev local SaaS, use o MESMO projeto Supabase esperado pelo app (`5176`)
# e pelo backend local (`3001`) para evitar JWT/token/contexto incompatíveis.
# Não use placeholders tipo eyJ... ou ... no fim — a chave inteira vem do dashboard.

VITE_CONSOLE_SUPABASE_URL=https://SEU_REF.supabase.co

# Defina UMA das duas (anon JWT eyJ… longo OU publishable sb_publishable_… completa):
VITE_CONSOLE_SUPABASE_ANON_KEY=
# VITE_CONSOLE_SUPABASE_PUBLISHABLE_KEY=

# Backend local (login Console → GET /internal/platform/console-profile).
# Em `npm run dev` da Console, pode omitir: o Vite faz proxy de /internal/platform para 3001.
# Use URL absoluta só se o backend não for local (ex.: staging) ou no build de produção.
# VITE_PLATFORM_API_BASE_URL=http://localhost:3001
VITE_PLATFORM_API_KEY=
