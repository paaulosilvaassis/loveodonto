{
  "name": "lasy-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "env:check": "node ./scripts/preflight-local.mjs --mode stack",
    "smoke": "node ./scripts/smoke-local.mjs",
    "preflight:app": "node ./scripts/preflight-local.mjs --mode app",
    "preflight:api": "node ./scripts/preflight-local.mjs --mode api",
    "preflight:console": "node ./scripts/preflight-local.mjs --mode console-vite",
    "vite:clean": "node scripts/clean-vite-cache.mjs",
    "dev": "node ./scripts/preflight-local.mjs --mode app && node scripts/esbuild-preflight.js && node scripts/debug-dev.js && vite",
    "dev:all": "concurrently -n app,saas -c cyan,magenta \"npm run dev\" \"node ./scripts/dev-console-with-api.js\"",
    "start:dev": "node ./scripts/preflight-local.mjs --mode app && node scripts/esbuild-preflight.js && node scripts/debug-dev.js && vite --mode development",
    "build": "tsc -b && vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "db:migrate:dev": "node scripts/migrate-dev-db.js",
    "db:seed:dev": "node scripts/seed-dev-db.js",
    "db:reset:dev": "node scripts/reset-dev-db.js",
    "organize-export": "node scripts/organize-patient-export.js",
    "console:dev": "node ./scripts/dev-console-with-api.js",
    "console:stack": "npm run console:dev",
    "console:vite": "node ./scripts/dev-console-with-api.js",
    "console:vite-only": "node ./scripts/preflight-local.mjs --mode console-vite && cd console && npm run dev",
    "api:dev": "node ./scripts/preflight-local.mjs --mode api && cd server && npm run dev",
    "backend:dev": "node ./scripts/preflight-local.mjs --mode api && cd server && npm run dev",
    "console:build": "cd console && npm run build",
    "server:dev": "node ./scripts/preflight-local.mjs --mode api && cd server && npm run dev",
    "server:restart": "powershell -ExecutionPolicy Bypass -File \"scripts/restart-backend.ps1\"",
    "server:restar": "powershell -ExecutionPolicy Bypass -File \"scripts/restart-backend.ps1\"",
    "stack:start": "powershell -ExecutionPolicy Bypass -File \"scripts/start-local-stack.ps1\"",
    "server:start": "cd server && npm run start"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@supabase/supabase-js": "^2.93.3",
    "@tailwindcss/vite": "^4.1.17",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "pdfmake": "^0.3.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.2.2",
    "react-router-dom": "^7.12.0",
    "recharts": "^2.15.4",
    "shadcn": "^3.6.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4",
    "concurrently": "^9.2.0"
  }
}
