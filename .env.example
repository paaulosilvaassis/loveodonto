# ===========================================
# App (frontend, porta 5176) — variáveis VITE_*
# Mesmo projeto Supabase que console/.env e server/.env em fluxo SaaS local.
# ===========================================

# Supabase — app das clínicas (dados por tenant)
# Em fluxo SaaS local, use o MESMO projeto que VITE_SUPABASE_PLATFORM_URL
# (senão o bridge de sessão Platform→App não sincroniza o JWT).
VITE_SUPABASE_APP_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_APP_ANON_KEY=sua-anon-key
# Se APP_ANON_KEY ficar vazio, o app usa VITE_SUPABASE_PLATFORM_ANON_KEY como fallback.

# Supabase — login SaaS no app (Auth + RPC get_app_user_tenant_access + tabelas platform)
# Deve ser o MESMO projeto que VITE_CONSOLE_SUPABASE_* e SUPABASE_URL do backend.
# Em dev, se vazio, o vite.config.js usa fallback de console/.env (VITE_CONSOLE_SUPABASE_*).
VITE_SUPABASE_PLATFORM_URL=
VITE_SUPABASE_PLATFORM_ANON_KEY=

# Modo SaaS: em produção use "1". Em dev, basta PLATFORM_URL+KEY acima.
# VITE_ACCESS_SAAS_ENABLED=1

# Phase 10.21K — teste LOCAL da UX operacional (somente DEV + localhost/127.0.0.1).
# NÃO definir em produção / Vercel. Mesmo se vazado, o runtime exige DEV + hostname local.
# VITE_CONTRACTS_OPERATIONAL_UX_LOCAL_TEST=true

# Admin API — obrigatório em produção (Vercel). Em dev, use .env.development ou:
# VITE_PLATFORM_API_BASE_URL=http://127.0.0.1:3001
# (vazio em dev = proxy Vite /internal/app → :3001)
# Use a URL pública do server/ deployado (Railway, Render, Fly, etc.)
# VITE_PLATFORM_API_BASE_URL=https://sua-admin-api.exemplo.com
# Alias aceito no app principal:
# VITE_APP_ADMIN_API_BASE_URL=https://sua-admin-api.exemplo.com

# ===========================================
# Backend (server/, porta 3001) — NÃO são VITE_; só no processo Node
# ===========================================
# SUPABASE_URL=        # mesmo host que VITE_SUPABASE_PLATFORM_URL
# SUPABASE_SERVICE_ROLE_KEY=
# PLATFORM_API_KEY=    # mesmo valor que VITE_PLATFORM_API_KEY na Console
# ADMIN_API_PORT=3001

# Dev — npm run console:dev tenta libertar a porta 5177 automaticamente (Windows/macOS/Linux).
# LOVE_ODONTO_SKIP_PORT_FREE=1
#
# Scripts: npm run dev (só app 5176) | npm run dev:server (só API 3001)
#          npm run dev:stack (API 3001 + app 5176) | npm run console:dev (API + Console 5177)
#          npm run dev:all (app 5176 + stack Console em paralelo) | npm run env:check

# ===========================================
# Contracts V2 runtime (Phase 10.12) — defaults seguros / OFF
# NÃO colocar secrets reais neste arquivo. NÃO expor ao frontend.
# ===========================================
# CONTRACTS_V2_RUNTIME_MODE=disabled
# CONTRACTS_V2_DATABASE_MODE=unavailable
# CONTRACTS_V2_STORAGE_MODE=unavailable
# CONTRACTS_V2_DELIVERY_MODE=disabled
# CONTRACTS_V2_RATE_LIMIT_MODE=disabled
# CONTRACTS_V2_PUBLIC_BASE_URL=
# CONTRACTS_V2_PUBLIC_ALLOWED_ORIGINS=
# CONTRACTS_V2_PRIVATE_BUCKET=
# CONTRACTS_V2_TRUST_PROXY=0
# CONTRACTS_V2_SIGNING_TOKEN_SECRET=
# CONTRACTS_V2_STORAGE_SIGNED_URL_TTL=60
# Modos permitidos: disabled | memory-test | local-integration | staging-disabled
# Bucket staging planejado (NÃO criar remotamente nesta fase): contracts-v2-private-staging
