# ===========================================
# App (frontend) – variáveis expostas no build (prefixo VITE_)
# Preencha e renomeie para .env ou configure no painel do provedor de deploy.
# Em dev local SaaS, o app (`5176`) deve apontar para o mesmo projeto Supabase
# usado pela Console (`5177`) e pelo backend local (`3001`).
# ===========================================

# Supabase – app das clínicas (obrigatório para produção)
VITE_SUPABASE_APP_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_APP_ANON_KEY=sua-anon-key

# Opcional: mesmo projeto pode usar aliases
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-anon-key

# Supabase – fluxo SaaS / platform (obrigatório para login SaaS no app)
# Se preferir, em DEV o `vite.config.js` da raiz consegue usar como fallback
# os valores definidos em `console/.env`, mas o ideal é manter explícito aqui.
VITE_SUPABASE_PLATFORM_URL=
VITE_SUPABASE_PLATFORM_ANON_KEY=

# ===========================================
# Backend local (porta 3001) – necessário para `/internal/app/tenant-context`
# NUNCA coloque estas chaves no frontend. Use apenas no ambiente do server.
# ===========================================
# ADMIN_API_KEY=
# PLATFORM_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
