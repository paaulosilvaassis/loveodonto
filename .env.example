# ===========================================
# App (frontend) – variáveis expostas no build (prefixo VITE_)
# Preencha e renomeie para .env ou configure no painel do provedor de deploy.
# ===========================================

# Supabase – app das clínicas (obrigatório para produção)
VITE_SUPABASE_APP_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_APP_ANON_KEY=sua-anon-key

# Opcional: mesmo projeto pode usar aliases
# VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# VITE_SUPABASE_ANON_KEY=sua-anon-key

# Supabase – painel platform (apenas se usar /platform)
VITE_SUPABASE_PLATFORM_URL=
VITE_SUPABASE_PLATFORM_ANON_KEY=

# ===========================================
# Server (API admin) – NUNCA colocar no frontend
# Usar apenas no ambiente do server (Railway, Render, etc.)
# ===========================================
# ADMIN_API_KEY=
# PLATFORM_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
