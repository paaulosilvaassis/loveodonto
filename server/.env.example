# Admin API (3001) — preferir um único `.env` na RAIZ do repositório (sobrescreve este ficheiro).
# Lá defina SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY do MESMO projeto que VITE_CONSOLE_SUPABASE_*.
#
# Ordem de carga no Node: server/.env → ../.env → ../.env.local (último ganha).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mesmo segredo que VITE_PLATFORM_API_KEY na Console (rotas /internal/platform/*)
PLATFORM_API_KEY=

# Porta HTTP (padrão 3001)
# ADMIN_API_PORT=3001
