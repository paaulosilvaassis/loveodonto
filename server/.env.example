# Admin API (porta 3001 em dev) — variáveis necessárias para rodar o backend.
# Em produção (Railway/Render/Fly), configure essas mesmas chaves no painel do host,
# NÃO commite valores reais. No dev local, prefira o `.env` na RAIZ do repositório
# (sobrescreve este ficheiro: server/.env → ../.env → ../.env.local).

# ── Supabase (service role, NUNCA exposto ao frontend) ────────────────────────
# Mesmo projeto Supabase que o frontend usa via VITE_SUPABASE_APP_URL/ANON_KEY.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key do mesmo projeto — necessária para resetPasswordForEmail disparar SMTP do Auth.
# Em dev local, se vazio, o backend usa fallback de console/.env (VITE_CONSOLE_SUPABASE_ANON_KEY).
SUPABASE_ANON_KEY=

# ── Chave compartilhada com o Console (rotas /internal/platform/*) ───────────
# Mesmo valor que VITE_PLATFORM_API_KEY na Console.
PLATFORM_API_KEY=

# ── Rede ───────────────────────────────────────────────────────────────────────
# PORT é injetada automaticamente pelo Railway/Render/Fly. Localmente, default 3001.
# ADMIN_API_PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista separada por vírgula. Vazio = default (loveodonto.com.br + localhost dev + *.vercel.app).
# Use "*" apenas em diagnóstico — nunca em produção real.
# ADMIN_API_CORS_ORIGINS=https://loveodonto.com.br,https://www.loveodonto.com.br

# ── Convites e e-mail transacional ────────────────────────────────────────────
# URL pública do app para redirect após validação do link Supabase.
# Dev local (opcional): http://localhost:5176/primeiro-acesso
# Produção (Railway): use loveodonto.com.br — NÃO use localhost:3000
# No Supabase Auth → URL Configuration, inclua também:
#   https://loveodonto.com.br/primeiro-acesso
#   https://loveodonto.com.br/**
#   http://localhost:5176/primeiro-acesso
#   http://localhost:5176/**
APP_URL=https://loveodonto.com.br
APP_INVITE_REDIRECT_TO=https://loveodonto.com.br/primeiro-acesso

# Provedor de e-mail (resend | sendgrid) — OBRIGATÓRIO no Railway para entrega confiável
# Sem EMAIL_API_KEY o backend usa SMTP padrão Supabase (Hotmail/Outlook costuma bloquear).
# EMAIL_PROVIDER=resend
# EMAIL_FROM_NAME=Love Odonto
# EMAIL_FROM_ADDRESS=no-reply@loveodonto.com.br
# EMAIL_API_KEY=re_sua_chave_resend
# APP_URL=https://loveodonto.com.br
