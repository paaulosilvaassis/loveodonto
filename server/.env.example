# Admin API (3001) — service role do MESMO projeto Supabase que app (VITE_SUPABASE_PLATFORM_*)
# e Console (VITE_CONSOLE_SUPABASE_*).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mesmo segredo que VITE_PLATFORM_API_KEY na Console (rotas /internal/platform/*)
PLATFORM_API_KEY=

# Porta HTTP (padrão 3001)
# ADMIN_API_PORT=3001
